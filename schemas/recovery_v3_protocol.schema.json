{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E-JEPA-TTC recovery protocol",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {"const": "3.0"},
    "claim_level": {"const": "diagnostic"},
    "test_status": {"const": "reused_test_diagnostic"},
    "cache_format_version": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evttc_dataset_manifest": {"type": "string", "minLength": 1},
        "evttc_split_manifest": {"type": "string", "minLength": 1},
        "evttc_cache": {"type": "string", "minLength": 1},
        "eap_remote_manifest": {"type": "string", "minLength": 1},
        "eap_split_manifest": {"type": "string", "minLength": 1}
      },
      "required": [
        "evttc_dataset_manifest",
        "evttc_split_manifest",
        "evttc_cache",
        "eap_remote_manifest",
        "eap_split_manifest"
      ]
    },
    "matrix": {"$ref": "#/$defs/matrix"},
    "eap_matrix": {"$ref": "#/$defs/eapMatrix"},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_ego_actions": {"type": "boolean"},
        "use_recurrence": {"type": "boolean"},
        "use_geometry": {"type": "boolean"}
      },
      "required": ["use_ego_actions", "use_recurrence", "use_geometry"]
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_windows_per_sequence": {"type": "integer", "minimum": 1},
        "sample_count_total_limit": {"type": "integer", "minimum": 1},
        "iterations_limit": {"type": "integer", "minimum": 1}
      },
      "required": ["max_windows_per_sequence", "sample_count_total_limit", "iterations_limit"]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_metrics": {"$ref": "#/$defs/nonEmptyStrings"},
        "allowed_training_splits": {"$ref": "#/$defs/nonEmptyStrings"},
        "allowed_selection_splits": {"$ref": "#/$defs/nonEmptyStrings"},
        "allowed_calibration_splits": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_ordinary_splits": {"$ref": "#/$defs/nonEmptyStrings"},
        "min_train_support": {"type": "integer", "minimum": 1},
        "min_val_support": {"type": "integer", "minimum": 1},
        "checkpoint_selection_metric": {"type": "string", "minLength": 1},
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": ["name", "version", "manifest_hash"]
        }
      },
      "required": [
        "primary_metrics",
        "allowed_training_splits",
        "allowed_selection_splits",
        "allowed_calibration_splits",
        "forbidden_ordinary_splits",
        "min_train_support",
        "min_val_support",
        "checkpoint_selection_metric",
        "dataset"
      ]
    },
    "onnx_policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict_state_dict_loading": {"const": true},
        "output_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "maximum_absolute_error_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "mean_absolute_error_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "real_validation_samples": {"const": true}
      },
      "required": [
        "strict_state_dict_loading",
        "output_names",
        "maximum_absolute_error_tolerance",
        "mean_absolute_error_tolerance",
        "real_validation_samples"
      ]
    }
  },
  "required": [
    "protocol_version",
    "claim_level",
    "test_status",
    "cache_format_version",
    "resources",
    "matrix",
    "eap_matrix",
    "architecture",
    "smoke",
    "requirements",
    "onnx_policies"
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssl_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "downstream_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "nav_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["enabled", "disabled"]}},
        "label_fractions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
      },
      "required": ["ssl_seeds", "downstream_seeds", "nav_modes", "label_fractions"]
    },
    "eapMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssl_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "downstream_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "label_fractions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
      },
      "required": ["ssl_seeds", "downstream_seeds", "label_fractions"]
    }
  }
}
