{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Equivalence V3",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "real_validation_samples": {
      "type": "boolean"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_absolute_error": {
      "type": "number"
    },
    "mean_absolute_error": {
      "type": "number"
    },
    "maximum_relative_error": {"type": "number"},
    "absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
    "relative_tolerance": {"type": "number", "exclusiveMinimum": 0},
    "sample_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "real_validation_samples",
    "sample_count",
    "maximum_absolute_error",
    "mean_absolute_error",
    "maximum_relative_error",
    "absolute_tolerance",
    "relative_tolerance",
    "sample_id_hash",
    "artifact_type",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
