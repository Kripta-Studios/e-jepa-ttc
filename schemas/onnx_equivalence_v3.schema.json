{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Equivalence V3",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "real_validation_samples": {
      "type": "boolean"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_absolute_error": {
      "type": "number"
    },
    "mean_absolute_error": {
      "type": "number"
    },
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "real_validation_samples",
    "sample_count",
    "maximum_absolute_error",
    "mean_absolute_error"
  ],
  "additionalProperties": true
}