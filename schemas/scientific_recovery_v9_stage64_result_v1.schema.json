{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
  "required": ["artifact_type", "schema_version", "evidence_type", "code_commit", "protocol_version", "protocol_sha256", "created_at", "artifact_sha256", "seed", "status", "all_endpoints_frozen_before_evaluation", "gates", "elapsed_active_seconds", "training_lock_sha256", "output_bindings"],
