    "code_commit": {"type": "string"}, "protocol_version": {"type": "string"}, "protocol_sha256": {"type": "string"}, "created_at": {"type": "string"}, "artifact_sha256": {"type": "string"},
    "training_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
