    "seed": {"enum": [7, 13, 23]}, "status": {"enum": ["RAW_ALL_GATES_PASSED", "RAW_GATES_FAILED", "RAW_RESOURCE_BLOCKED"]}, "all_endpoints_frozen_before_evaluation": {"const": true}, "gates": {"type": "object"}, "elapsed_active_seconds": {"type": "number", "minimum": 0}
  }, "additionalProperties": false
}
