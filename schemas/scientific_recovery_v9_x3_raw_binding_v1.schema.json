{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific_recovery_v9_x3_raw_binding_v1.schema.json",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256",
    "status",
    "training_executed",
    "binding_csv",
    "stage_metadata",
    "garl_train_manifest",
    "eap_root",
    "tokens",
    "tokens_unique",
    "sequences",
    "tracks",
    "windows",
    "raw_event_references",
    "event_files",
    "forbidden_paths_opened",
    "labels_opened",
    "all_paths_train_only",
    "timestamps_available",
    "polarity_available",
    "event_counts_per_token_available",
    "raw_intervals_per_token_available",
    "read_probe",
    "future_cache_proposal"
  ],
  "properties": {
    "artifact_type": {"const": "scientific_recovery_v9_x3_raw_binding_v1"},
    "schema_version": {"const": "1.0"},
    "evidence_type": {"const": "read_only_feasibility"},
    "code_commit": {"type": "string"},
    "protocol_version": {"const": "stage61_stage62_v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "completed"},
    "training_executed": {"const": false},
    "binding_csv": {"type": "object"},
    "stage_metadata": {"type": "object"},
    "garl_train_manifest": {"type": "object"},
    "eap_root": {"type": "string"},
    "tokens": {"type": "integer", "minimum": 1},
    "tokens_unique": {"type": "integer", "minimum": 1},
    "sequences": {"type": "integer", "minimum": 1},
    "tracks": {"type": "integer", "minimum": 1},
    "windows": {"type": "integer", "minimum": 1},
    "raw_event_references": {"type": "integer", "minimum": 1},
    "event_files": {"type": "array", "minItems": 1},
    "forbidden_paths_opened": {"const": false},
    "labels_opened": {"const": false},
    "all_paths_train_only": {"const": true},
    "timestamps_available": {"const": true},
    "polarity_available": {"const": true},
    "event_counts_per_token_available": {"const": true},
    "raw_intervals_per_token_available": {"const": true},
    "read_probe": {"type": "object"},
    "future_cache_proposal": {"type": "object"}
  },
  "additionalProperties": false
}
