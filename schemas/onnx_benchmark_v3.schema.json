{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Benchmark V3",
  "type": "object",
  "properties": {
    "device": {"type": "string"},
    "batch_size": {"type": "integer", "minimum": 1},
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "p50_ms": {
      "type": "number"
    },
    "p95_ms": {
      "type": "number"
    },
    "p99_ms": {
      "type": "number"
    },
    "mean_ms": {"type": "number", "minimum": 0},
    "hardware": {
      "type": "object",
      "properties": {
        "cpu_name": {"type": "string"},
        "logical_cores": {"type": ["integer", "null"]},
        "physical_cores": {"type": ["integer", "null"]},
        "ram_gb": {"type": "number"},
        "gpu_name": {"type": ["string", "null"]}
      },
      "required": ["cpu_name", "logical_cores", "physical_cores", "ram_gb", "gpu_name"],
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    }
  },
  "required": [
    "iterations",
    "device",
    "batch_size",
    "mean_ms",
    "hardware",
    "p50_ms",
    "p95_ms",
    "p99_ms",
    "artifact_type",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
