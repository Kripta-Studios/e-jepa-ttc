{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Manifest V3",
  "type": "object",
  "properties": {
    "checkpoint_path": {"type": "string"},
    "onnx_path": {"type": "string"},
    "model_name": {"type": "string"},
    "model_config_sha256": {"type": "string"},
    "cache_sha256": {"type": "string"},
    "navigation_mode": {"type": "string"},
    "normalization_sha256": {"type": "string"},
    "in_channels": {"type": "integer", "minimum": 1},
    "selection_split": {
      "type": "string"
    },
    "strict_state_dict_loading": {
      "type": "boolean"
    },
    "output_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_sha256": {
      "type": "string",
      "minLength": 64
    },
    "onnx_sha256": {
      "type": "string",
      "minLength": 64
    },
    "resolved_model_config": {
      "type": "object"
    },
    "selection_metric": {"type": "string"},
    "selected_checkpoint_code_commit": {"type": "string"},
    "diagnostic_split_consulted": {"type": "boolean"},
    "final_test_opened": {"type": "boolean"},
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    }
  },
  "required": [
    "selection_split",
    "checkpoint_path",
    "onnx_path",
    "model_name",
    "in_channels",
    "selection_metric",
    "diagnostic_split_consulted",
    "final_test_opened",
    "strict_state_dict_loading",
    "output_names",
    "checkpoint_sha256",
    "onnx_sha256",
    "resolved_model_config",
    "artifact_type",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
