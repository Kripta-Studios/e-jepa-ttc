{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Manifest V3",
  "type": "object",
  "properties": {
    "selection_split": {
      "type": "string"
    },
    "strict_state_dict_loading": {
      "type": "boolean"
    },
    "output_names": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checkpoint_sha256": {
      "type": "string",
      "minLength": 64
    },
    "onnx_sha256": {
      "type": "string",
      "minLength": 64
    },
    "resolved_model_config": {
      "type": "object"
    }
  },
  "required": [
    "selection_split",
    "strict_state_dict_loading",
    "output_names",
    "checkpoint_sha256",
    "onnx_sha256",
    "resolved_model_config"
  ],
  "additionalProperties": true
}
