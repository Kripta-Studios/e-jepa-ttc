{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX Manifest V3",
  "type": "object",
  "properties": {
    "selection_split": {
      "type": "string"
    },
    "strict_state_dict_loading": {
      "type": "boolean"
    },
    "output_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_sha256": {
      "type": "string",
      "minLength": 64
    },
    "onnx_sha256": {
      "type": "string",
      "minLength": 64
    },
    "resolved_model_config": {
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    }
  },
  "required": [
    "selection_split",
    "strict_state_dict_loading",
    "output_names",
    "checkpoint_sha256",
    "onnx_sha256",
    "resolved_model_config",
    "artifact_type",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}