{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": [
        "stage_record_v3"
      ]
    },
    "stage": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "passed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "duration_s": {
      "type": "number"
    },
    "exit_code": {
      "type": "integer"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "working_tree_clean": {"type": "boolean"},
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    }
  },
  "required": [
    "artifact_type",
    "stage",
    "status",
    "started_at",
    "completed_at",
    "duration_s",
    "exit_code",
    "command",
    "inputs",
    "outputs",
    "environment_hash",
    "working_tree_clean",
    "schema_version",
    "evidence_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
