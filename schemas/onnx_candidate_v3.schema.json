    "selection_split",
    "code_commit",
    "schema_version",
    "evidence_type",
    "protocol_version",
    "created_at",
    "artifact_sha256"
    ,"run_id"
    ,"model_name"
    ,"seed"
    ,"label_fraction"
    ,"train_sample_count"
    ,"validation_sample_count"
