{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "arm_id",
    "reference_family",
    "reference_identity",
    "decision",
    "checks",
    "artifact_sha256"
  ],
  "properties": {
    "artifact_type": {
      "const": "eclock_x0_gate_decision_v2"
    },
    "arm_id": {
      "enum": [
        "X0-A5-REPLAY",
        "X0-PAIR-U",
        "X0-BASE-U",
        "X0-DYN-U"
      ]
    },
    "reference_family": {
      "const": "official_a5_oof"
    },
    "reference_identity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "artifact_sha256",
        "bytes",
        "producer_identity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "producer_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$id": "scientific_recovery_v9_eclock_gate_decision_v2.schema.json"
}
