{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token_scaling_benchmark_v1.schema.json",
  "title": "High-resolution token scaling benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "evidence_type", "code_commit", "protocol_version", "protocol_sha256", "created_at", "artifact_sha256", "status", "results"],
  "properties": {
    "artifact_type": {"const": "highres_token_scaling_benchmark_v1"},
    "schema_version": {"type": "string"},
    "evidence_type": {"type": "string"},
    "code_commit": {"type": "string"},
    "protocol_version": {"type": "string"},
    "protocol_sha256": {"type": "string"},
    "created_at": {"type": "string"},
    "artifact_sha256": {"type": "string"},
    "status": {"enum": ["pass", "failed"]},
    "results": {"type": "array"}
  }
}
