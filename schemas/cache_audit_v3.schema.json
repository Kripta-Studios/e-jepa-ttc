{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cache Audit V3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_verifiable"
      ]
    },
    "audit_mode": {
      "type": "string",
      "enum": [
        "sampled",
        "exhaustive"
      ]
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "synthetic_ci",
        "real_smoke",
        "validation_pilot",
        "validation_matrix",
        "final_test"
      ]
    },
    "reason": {
      "type": "string"
    },
    "cache_format_version": {
      "type": "integer"
    },
    "cache_path": {
      "type": "string"
    },
    "cache_sha256_computed": {
      "type": "string"
    },
    "cache_sha256_declared": {
      "type": "string"
    },
    "sidecar_sha256_matches": {
      "type": "boolean"
    },
    "normalize": {
      "type": "boolean"
    },
    "normalization": {
      "type": "string"
    },
    "normalizer_source_split": {
      "type": "string"
    },
    "normalizer_origins_verified": {
      "type": "boolean"
    },
    "sample_count_total": {
      "type": "integer"
    },
    "sample_count_audited": {
      "type": "integer"
    },
    "nonempty_samples_collapsed_to_zero": {
      "type": "integer"
    },
    "checks": {
      "type": "object"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "code_commit": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "protocol_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status",
    "audit_mode",
    "evidence_type",
    "cache_format_version",
    "cache_path",
    "cache_sha256_computed",
    "cache_sha256_declared",
    "sidecar_sha256_matches",
    "normalize",
    "normalization",
    "normalizer_source_split",
    "normalizer_origins_verified",
    "sample_count_total",
    "sample_count_audited",
    "nonempty_samples_collapsed_to_zero",
    "checks",
    "failures",
    "warnings",
    "provenance",
    "artifact_type",
    "code_commit",
    "protocol_version",
    "protocol_sha256",
    "created_at",
    "artifact_sha256"
  ],
  "additionalProperties": false
}