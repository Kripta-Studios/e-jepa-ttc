+from __future__ import annotations
+
+import numpy as np
+
+from e_jepa_ttc.data.eap import project_box_3d_to_event_with_visibility
+
+
+def test_projection_retains_unclipped_box():
+    intrinsic = np.asarray([[100.0, 0.0, 20.0], [0.0, 100.0, 20.0], [0.0, 0.0, 1.0]])
+    transform = np.eye(4)
+    box = (-2.0, 0.0, 10.0, 4.0, 2.0, 2.0, 0.0)
+    _corners, clipped, raw, depth, visible_height = project_box_3d_to_event_with_visibility(
+        box, intrinsic, transform, image_size=(64, 64)
+    )
+    assert raw[0] < clipped[0] or raw[2] > clipped[2]
+    assert depth > 0
+    assert visible_height > 0
