index 0000000..9b09a9b
--- /dev/null
+++ b/src/e_jepa_ttc/data/eap_motion_risk.py
@@ -0,0 +1,206 @@
+"""Motion, visibility and collision-corridor targets for eAP-Geo v2.
+
+The feature vector intentionally separates observable image-plane quantities
+from reconstructed depth dynamics.  It is suitable for auxiliary pretraining;
+it is not presented as an official eAP TTC annotation.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Iterable
+
+import numpy as np
+
+from e_jepa_ttc.data.eap import EAP_IMAGE_SIZE, EAPObjectState
+
+GEO_V2_TARGET_NAMES = (
+    "center_x",
+    "center_y",
+    "width",
+    "height",
+    "depth_closing",
+    "log_height_rate",
+    "center_velocity_x",
+    "center_velocity_y",
+    "radiality_log",
+    "visible_fraction",
+    "truncated_left",
+    "truncated_right",
+    "track_age",
+    "log_visible_area_rate",
+    "corridor_center_distance",
+    "corridor_overlap",
+    "corridor_entry_direction",
+    "category_vehicle",
+    "category_pedestrian",
+    "category_cyclist",
+    "category_other",
+)
+GEO_V2_TARGET_DIM = len(GEO_V2_TARGET_NAMES)
+
+
+@dataclass(frozen=True)
+class MotionRiskTarget:
+    values: np.ndarray
+    valid: np.ndarray
+    stratum: tuple[str, ...]
+
+
+def _box_area(box: tuple[float, float, float, float]) -> float:
+    return max(0.0, box[2] - box[0]) * max(0.0, box[3] - box[1])
+
+
+def _category_group(category: str) -> str:
+    value = category.lower()
+    if any(token in value for token in ("car", "vehicle", "truck", "bus", "van")):
+        return "vehicle"
+    if any(token in value for token in ("pedestrian", "person", "human")):
+        return "pedestrian"
+    if any(token in value for token in ("cyclist", "bicycle", "bike", "motorcycle")):
+        return "cyclist"
+    return "other"
+
+
+def motion_risk_target(
+    state: EAPObjectState,
+    previous: EAPObjectState | None,
+    first: EAPObjectState | None,
+    *,
+    corridor_center_x: float = 0.5,
+    corridor_width: float = 0.24,
+    epsilon: float = 1e-4,
+) -> MotionRiskTarget:
+    """Create normalized 2-D motion, visibility and trajectory-risk targets."""
+
+    if not 0.0 < corridor_width <= 1.0:
+        raise ValueError("corridor_width must lie in (0, 1].")
+    image_width, image_height = EAP_IMAGE_SIZE
+    x0, y0, x1, y1 = state.bbox_xyxy
+    cx = 0.5 * (x0 + x1) / image_width
+    cy = 0.5 * (y0 + y1) / image_height
+    width = (x1 - x0) / image_width
+    height = (y1 - y0) / image_height
+    raw = state.unclipped_bbox_xyxy or state.bbox_xyxy
+    visible_fraction = _box_area(state.bbox_xyxy) / max(_box_area(raw), epsilon)
+    truncated_left = float(raw[0] < 0.0)
+    truncated_right = float(raw[2] > image_width - 1)
+
+    vx = vy = log_height_rate = log_area_rate = float("nan")
+    previous_distance = float("nan")
+    if previous is not None:
+        dt = (state.timestamp_us - previous.timestamp_us) * 1e-6
+        if 0.0 < dt <= 0.5:
+            pcx, pcy = previous.center_xy
+            vx = ((0.5 * (x0 + x1)) - pcx) / image_width / dt
+            vy = ((0.5 * (y0 + y1)) - pcy) / image_height / dt
+            log_height_rate = (
+                math.log(max(state.visible_height_px, epsilon))
+                - math.log(max(previous.visible_height_px, epsilon))
+            ) / dt
+            log_area_rate = (
+                math.log(max(_box_area(state.bbox_xyxy), epsilon))
+                - math.log(max(_box_area(previous.bbox_xyxy), epsilon))
+            ) / dt
+            previous_distance = abs(previous.center_xy[0] / image_width - corridor_center_x)
+
+    radiality = (
+        (abs(vx) + abs(vy)) / (abs(log_height_rate) + epsilon)
+        if np.isfinite(vx) and np.isfinite(vy) and np.isfinite(log_height_rate)
+        else float("nan")
+    )
+    radiality_log = math.log1p(radiality) / math.log(11.0) if np.isfinite(radiality) else float("nan")
+    age_s = (
+        max(0.0, (state.timestamp_us - first.timestamp_us) * 1e-6)
+        if first is not None
+        else float("nan")
+    )
+
+    corridor_left = corridor_center_x - 0.5 * corridor_width
+    corridor_right = corridor_center_x + 0.5 * corridor_width
+    object_left = x0 / image_width
+    object_right = x1 / image_width
+    overlap = max(0.0, min(object_right, corridor_right) - max(object_left, corridor_left))
+    corridor_overlap = overlap / max(width, epsilon)
+    corridor_distance = abs(cx - corridor_center_x) / max(0.5, epsilon)
+    current_distance = abs(cx - corridor_center_x)
+    entry_direction = (
+        np.clip((previous_distance - current_distance) * 4.0, -1.0, 1.0)
+        if np.isfinite(previous_distance)
+        else float("nan")
+    )
+    category = _category_group(state.category)
+    one_hot = [float(category == name) for name in ("vehicle", "pedestrian", "cyclist", "other")]
+
+    values = np.asarray(
+        [
+            cx,
+            cy,
+            width,
+            height,
+            np.clip(-state.depth_velocity_mps / 20.0, -1.0, 1.0),
+            np.clip(log_height_rate / 5.0, -1.0, 1.0),
+            np.clip(vx / 2.0, -1.0, 1.0),
+            np.clip(vy / 2.0, -1.0, 1.0),
+            np.clip(radiality_log, 0.0, 1.0),
+            np.clip(visible_fraction, 0.0, 1.0),
+            truncated_left,
+            truncated_right,
+            np.clip(age_s / 5.0, 0.0, 1.0),
+            np.clip(log_area_rate / 5.0, -1.0, 1.0),
+            np.clip(corridor_distance, 0.0, 1.0),
+            np.clip(corridor_overlap, 0.0, 1.0),
+            entry_direction,
+            *one_hot,
+        ],
+        dtype=np.float32,
+    )
+    valid = np.isfinite(values)
+    values[~valid] = 0.0
+    motion = "lateral" if np.isfinite(radiality) and radiality >= 1.0 else "radial"
+    visibility = "partial" if visible_fraction < 0.9 else "full"
+    axis = "transverse" if np.isfinite(vx) and abs(vx) > abs(log_height_rate) * 0.15 else "longitudinal"
+    corridor = "entering" if np.isfinite(entry_direction) and entry_direction > 0.05 else "not_entering"
+    return MotionRiskTarget(values=values, valid=valid, stratum=(category, motion, visibility, axis, corridor))
+
+
+def balanced_round_robin_indices(
+    strata: Iterable[tuple[str, ...]],
+    maximum: int,
+    *,
+    seed: int,
+) -> list[int]:
+    """Select deterministically while preventing large strata from dominating."""
+
+    if maximum <= 0:
+        raise ValueError("maximum must be positive.")
+    groups: dict[tuple[str, ...], list[int]] = {}
+    for index, key in enumerate(strata):
+        groups.setdefault(tuple(key), []).append(index)
+    rng = np.random.default_rng(seed)
+    for values in groups.values():
+        rng.shuffle(values)
+    keys = sorted(groups)
+    selected: list[int] = []
+    cursor = 0
+    while keys and len(selected) < maximum:
+        key = keys[cursor % len(keys)]
+        values = groups[key]
+        if values:
+            selected.append(values.pop())
+        if not values:
+            keys.remove(key)
+            cursor = 0
+        else:
+            cursor += 1
+    return selected
+
+
+__all__ = [
+    "GEO_V2_TARGET_DIM",
+    "GEO_V2_TARGET_NAMES",
+    "MotionRiskTarget",
+    "balanced_round_robin_indices",
+    "motion_risk_target",
+]
