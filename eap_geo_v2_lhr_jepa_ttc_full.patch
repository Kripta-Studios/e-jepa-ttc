+from __future__ import annotations
+
+import numpy as np
+
+from e_jepa_ttc.data.eap import EAPObjectState
+from e_jepa_ttc.data.eap_motion_risk import (
+    GEO_V2_TARGET_NAMES,
+    balanced_round_robin_indices,
+    motion_risk_target,
+)
+
+
+def _state(timestamp: int, box, *, category="car", raw=None, depth_velocity=-2.0):
+    return EAPObjectState(
+        sample_token=str(timestamp),
+        sequence_id="s",
+        track_id="t",
+        category=category,
+        timestamp_us=timestamp,
+        bbox_xyxy=box,
+        bbox_3d_ego=(0, 0, 10, 4, 2, 2, 0),
+        nearest_depth_m=10.0,
+        visible_height_px=box[3] - box[1],
+        depth_velocity_mps=depth_velocity,
+        ttc_s=5.0,
+        unclipped_bbox_xyxy=raw,
+    )
+
+
+def test_motion_risk_detects_lateral_partial_object():
+    previous = _state(0, (100, 200, 200, 400))
+    current = _state(
+        100_000,
+        (300, 200, 400, 400),
+        raw=(-50, 200, 400, 400),
+        category="pedestrian",
+    )
+    target = motion_risk_target(current, previous, previous)
+    values = dict(zip(GEO_V2_TARGET_NAMES, target.values, strict=True))
+    assert values["center_velocity_x"] > 0
+    assert values["visible_fraction"] < 1
+    assert values["truncated_left"] == 1
+    assert values["category_pedestrian"] == 1
+    assert "lateral" in target.stratum
+    assert target.valid.dtype == np.bool_
+
+
+def test_balanced_round_robin_does_not_take_only_majority():
+    strata = [("vehicle",)] * 20 + [("pedestrian",)] * 2 + [("cyclist",)] * 2
+    selected = balanced_round_robin_indices(strata, 6, seed=7)
+    observed = {strata[index][0] for index in selected}
+    assert observed == {"vehicle", "pedestrian", "cyclist"}
