+#!/usr/bin/env python
+"""CLI for balanced eAP-Geo-v2 pretraining."""
+
+from __future__ import annotations
+
+import argparse
+import json
+
+from e_jepa_ttc.training.eap_geo_v2 import EAPGeoV2Config, train_eap_geo_v2
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", required=True)
+    parser.add_argument("--inventory", required=True)
+    parser.add_argument("--split", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--epochs", type=int, default=30)
+    parser.add_argument("--batch-size", type=int, default=24)
+    parser.add_argument("--workers", type=int, default=8)
+    parser.add_argument("--learning-rate", type=float, default=3e-4)
+    parser.add_argument("--max-samples-per-sequence", type=int, default=512)
+    parser.add_argument("--device", default="auto")
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+    config = EAPGeoV2Config(
+        epochs=args.epochs,
+        batch_size=args.batch_size,
+        workers=args.workers,
+        learning_rate=args.learning_rate,
+        max_samples_per_sequence=args.max_samples_per_sequence,
+        seed=args.seed,
+    )
+    result = train_eap_geo_v2(
+        root=args.root,
+        inventory_path=args.inventory,
+        split_path=args.split,
+        output_dir=args.output,
+        config=config,
+        device=args.device,
+    )
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
