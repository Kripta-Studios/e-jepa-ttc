@@ -0,0 +1,36 @@
+import pytest
+
+from scripts.aggregate_eap_lhr_zero_shot import aggregate_payloads
+
+
+def _payload(sequence: str, sample: str, target: float, prediction: float):
+    return {
+        "artifact_type": "eap_lhr_zero_shot_evttc_v1",
+        "cache_manifest": f"{sequence}.json",
+        "predictions": [
+            {
+                "sequence_id": sequence,
+                "sample_token": sample,
+                "track_id": "track",
+                "target_ttc_s": target,
+                "predicted_ttc_s": prediction,
+                "absolute_error_s": abs(prediction - target),
+            }
+        ],
+    }
+
+
+def test_aggregate_zero_shot_combines_disjoint_folds():
+    result = aggregate_payloads(
+        [_payload("a", "1", 2.0, 1.0), _payload("b", "2", 4.0, 3.0)]
+    )
+    assert result["fold_count"] == 2
+    assert result["sample_count"] == 2
+    assert result["mae_s"] == pytest.approx(1.0)
+    assert result["mean_relative_error"] == pytest.approx(0.375)
+
+
+def test_aggregate_zero_shot_rejects_duplicate_oof_rows():
+    row = _payload("a", "1", 2.0, 1.0)
+    with pytest.raises(ValueError, match="Duplicate OOF"):
+        aggregate_payloads([row, row])
