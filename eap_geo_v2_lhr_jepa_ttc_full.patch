+from scripts.analyze_eap_geo_v2_lhr import _control_mae, build_gate_payload
+
+
+def test_control_mae_reads_variant_from_aggregate():
+    aggregate = {
+        "ranking": [
+            {
+                "variant": "A0_MATCHED_GLOBAL",
+                "sequence_macro_mae_s_mean": 1.25,
+            }
+        ]
+    }
+    assert _control_mae(aggregate, "A0_MATCHED_GLOBAL") == 1.25
+
+
+def test_gate_rejects_lhr_that_does_not_beat_control():
+    control = {
+        "ranking": [
+            {
+                "variant": "A0_MATCHED_GLOBAL",
+                "sequence_macro_mae_s_mean": 1.0,
+            }
+        ]
+    }
+    geo = {
+        "comparisons": {
+            "sequence_macro_mae_s": {"candidate_relative_improvement_pct": 2.0},
+            "sequence_macro_mean_relative_error": {
+                "candidate_relative_improvement_pct": 1.0
+            },
+            "sequence_macro_selection_score": {
+                "candidate_relative_improvement_pct": 1.5
+            },
+        }
+    }
+    lhr = {"mae_s": 1.1, "mean_relative_error": 0.3}
+    payload = build_gate_payload(
+        control=control,
+        geo=geo,
+        lhr=lhr,
+        variant="A0_MATCHED_GLOBAL",
+    )
+    assert payload["geo_v2_gate"]["passed"] is True
+    assert payload["lhr_zero_shot_gate"]["passed"] is False
+    assert payload["passed"] is False
+    assert payload["decision"] == "do_not_promote"
diff --git a/tests/unit/test_eap_lhr_jepa_ttc.py b/tests/unit/test_eap_lhr_jepa_ttc.py
new file mode 100644
index 0000000..0e9503c
--- /dev/null
+++ b/tests/unit/test_eap_lhr_jepa_ttc.py
@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+import torch
+
+from e_jepa_ttc.models.eap_lhr_jepa_ttc import EAPLHRJEPATTC
+from e_jepa_ttc.training.eap_lhr_jepa_ttc import EAPLHRConfig, lhr_loss
+
+
+def test_lhr_model_keeps_geometric_head_and_is_finite():
+    model = EAPLHRJEPATTC()
+    model.eval()
+    event_roi = torch.randn(2, 40, 128, 128)
+    elapsed = torch.tensor([0.1, 0.1])
+    with torch.no_grad():
+        output = model(event_roi, elapsed)
+    assert output.ttc_seconds.shape == (2,)
+    assert output.visible_heights.shape == (2, 2)
+    assert bool((output.visible_heights > 0).all())
+    assert bool(torch.isfinite(output.ttc_seconds).all())
+
+
+def test_lhr_loss_is_finite_and_backpropagates():
+    model = EAPLHRJEPATTC()
+    output = model(torch.randn(2, 40, 128, 128), torch.tensor([0.1, 0.1]))
+    total, metrics = lhr_loss(
+        output,
+        target_heights=torch.tensor([[40.0, 44.0], [30.0, 32.0]]),
+        target_ttc_s=torch.tensor([1.1, 1.6]),
+        foreground=torch.zeros(2, 32, 32),
+        config=EAPLHRConfig(),
+    )
+    assert bool(torch.isfinite(total))
+    total.backward()
+    assert model.height_ratio_head.height_regressor.weight.grad is not None
+    assert set(metrics) == {"height", "ratio", "ttc", "direct_ttc", "jepa", "foreground"}
+
+
+def test_full_model_checkpoint_roundtrip():
+    source = EAPLHRJEPATTC()
+    target = EAPLHRJEPATTC()
+    target.load_state_dict(source.state_dict())
+    for left, right in zip(source.parameters(), target.parameters(), strict=True):
+        assert torch.equal(left, right)
