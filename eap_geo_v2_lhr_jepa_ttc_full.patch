+#!/usr/bin/env python
+"""Aggregate disjoint grouped-fold zero-shot predictions for eAP LHR."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from e_jepa_ttc.utils.io import write_structured
+
+
+def _load(path: str | Path) -> dict[str, Any]:
+    return json.loads(Path(path).read_text(encoding="utf-8"))
+
+
+def aggregate_payloads(payloads: list[dict[str, Any]]) -> dict[str, Any]:
+    if not payloads:
+        raise ValueError("At least one zero-shot payload is required.")
+    rows: list[dict[str, Any]] = []
+    seen: set[tuple[str, str, str]] = set()
+    manifests: list[str] = []
+    for payload in payloads:
+        if payload.get("artifact_type") != "eap_lhr_zero_shot_evttc_v1":
+            raise ValueError("Unexpected zero-shot artifact type.")
+        manifests.append(str(payload.get("cache_manifest")))
+        for raw in payload.get("predictions", []):
+            row = dict(raw)
+            identity = (
+                str(row.get("sequence_id")),
+                str(row.get("sample_token")),
+                str(row.get("track_id", "")),
+            )
+            if identity in seen:
+                raise ValueError(f"Duplicate OOF prediction: {identity}")
+            seen.add(identity)
+            rows.append(row)
+    if not rows:
+        raise ValueError("Zero-shot payloads contain no predictions.")
+    errors = np.asarray([float(row["absolute_error_s"]) for row in rows], dtype=np.float64)
+    relative = np.asarray(
+        [
+            float(row["absolute_error_s"])
+            / max(abs(float(row["target_ttc_s"])), 0.25)
+            for row in rows
+        ],
+        dtype=np.float64,
+    )
+    mae = float(errors.mean())
+    mre = float(relative.mean())
+    return {
+        "artifact_type": "eap_lhr_zero_shot_evttc_oof_aggregate_v1",
+        "cache_manifests": manifests,
+        "fold_count": len(payloads),
+        "sample_count": len(rows),
+        "mae_s": mae,
+        "mean_relative_error": mre,
+        "selection_score": mre + 0.25 * mae,
+        "benchmark10_opened": False,
+        "predictions": rows,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--inputs", nargs="+", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    payload = aggregate_payloads([_load(path) for path in args.inputs])
+    write_structured(args.output, payload)
+    print(json.dumps({k: v for k, v in payload.items() if k != "predictions"}, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
