@@ -0,0 +1,98 @@
+#!/usr/bin/env python
+"""Create explicit pass/fail gates for Geo-v2 transfer and LHR zero-shot."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+
+def _load(path: str) -> dict[str, Any]:
+    return json.loads(Path(path).read_text(encoding="utf-8"))
+
+
+def _control_mae(control: dict[str, Any], variant: str) -> float:
+    """Read a control MAE from an aggregate or comparison artifact."""
+
+    direct = control.get("sequence_macro_mae_s_mean")
+    if direct is not None:
+        return float(direct)
+
+    for record in control.get("ranking", []):
+        if str(record.get("variant")) == variant:
+            value = record.get("sequence_macro_mae_s_mean")
+            if value is None:
+                raise ValueError(f"Control record for {variant} has no mean MAE.")
+            return float(value)
+
+    comparison = control.get("comparisons", {}).get("sequence_macro_mae_s", {})
+    if comparison.get("control_mean") is not None:
+        return float(comparison["control_mean"])
+
+    raise ValueError(
+        f"Could not find a control MAE for variant {variant!r} in {control.get('artifact_type')!r}."
+    )
+
+
+def build_gate_payload(
+    *,
+    control: dict[str, Any],
+    geo: dict[str, Any],
+    lhr: dict[str, Any],
+    variant: str,
+) -> dict[str, Any]:
+    comparisons = geo.get("comparisons", {})
+    mae = comparisons.get("sequence_macro_mae_s", {})
+    mre = comparisons.get("sequence_macro_mean_relative_error", {})
+    score = comparisons.get("sequence_macro_selection_score", {})
+    geo_passed = all(
+        float(metric.get("candidate_relative_improvement_pct", -1.0)) > 0.0
+        for metric in (mae, mre, score)
+    )
+    control_mae = _control_mae(control, variant)
+    lhr_mae = float(lhr.get("mae_s", float("inf")))
+    lhr_passed = lhr_mae < control_mae
+    return {
+        "artifact_type": "eap_geo_v2_lhr_gate_v1",
+        "control_variant": variant,
+        "geo_v2_gate": {
+            "mae_improvement_pct": mae.get("candidate_relative_improvement_pct"),
+            "mre_improvement_pct": mre.get("candidate_relative_improvement_pct"),
+            "score_improvement_pct": score.get("candidate_relative_improvement_pct"),
+            "passed": geo_passed,
+        },
+        "lhr_zero_shot_gate": {
+            "mae_s": lhr.get("mae_s"),
+            "mean_relative_error": lhr.get("mean_relative_error"),
+            "control_mae_s": control_mae,
+            "beats_random_control": lhr_passed,
+            "passed": lhr_passed,
+        },
+        "passed": geo_passed and lhr_passed,
+        "decision": "promote" if geo_passed and lhr_passed else "do_not_promote",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--random-control", required=True)
+    parser.add_argument("--geo-v2-transfer", required=True)
+    parser.add_argument("--lhr-zero-shot", required=True)
+    parser.add_argument("--variant", default="A0_MATCHED_GLOBAL")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    payload = build_gate_payload(
+        control=_load(args.random_control),
+        geo=_load(args.geo_v2_transfer),
+        lhr=_load(args.lhr_zero_shot),
+        variant=args.variant,
+    )
+    Path(args.output).write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
