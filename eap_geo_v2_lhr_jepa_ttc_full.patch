diff --git a/src/e_jepa_ttc/training/eap_geo_v2.py b/src/e_jepa_ttc/training/eap_geo_v2.py
new file mode 100644
index 0000000..c060110
--- /dev/null
+++ b/src/e_jepa_ttc/training/eap_geo_v2.py
@@ -0,0 +1,345 @@
+"""Train eAP-Geo v2 with balanced object sampling and a full-frame/ROI path."""
+
+from __future__ import annotations
+
+import copy
+import math
+import time
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from torch import nn
+from torch.nn import functional as F
+from torch.utils.data import DataLoader, Dataset
+
+from e_jepa_ttc.data.eap import (
+    EAPEventReader,
+    EAPObjectState,
+    crop_events_to_roi,
+    load_eap_media_table,
+    load_eap_sequence_labels,
+    reconstruct_eap_object_states,
+)
+from e_jepa_ttc.data.eap_motion_risk import (
+    GEO_V2_TARGET_DIM,
+    balanced_round_robin_indices,
+    motion_risk_target,
+)
+from e_jepa_ttc.data.eap_representation import base_compatible_voxel, downsample_full_frame
+from e_jepa_ttc.models.eap_geo_v2 import EAPGeoV2Model
+from e_jepa_ttc.training.carla_jepa import (
+    EVTTC_BASE_INPUT_CHANNELS,
+    _artifact_hash,
+    _atomic_torch_save,
+    _git_commit,
+    _set_seed,
+    _source_tree_hash,
+)
+from e_jepa_ttc.training.jepa import _update_ema
+from e_jepa_ttc.utils.io import read_structured, write_structured
+
+
+@dataclass(frozen=True)
+class EAPGeoV2Config:
+    epochs: int = 30
+    batch_size: int = 24
+    learning_rate: float = 3e-4
+    weight_decay: float = 0.05
+    workers: int = 8
+    event_window_ms: int = 100
+    horizons_ms: tuple[int, ...] = (100, 250, 500)
+    max_samples_per_sequence: int = 512
+    full_width: int = 160
+    full_height: int = 90
+    roi_size: int = 128
+    bins: int = 5
+    geometry_weight: float = 0.5
+    foreground_weight: float = 0.1
+    roi_alignment_weight: float = 0.1
+    jepa_weight: float = 1.0
+    ema_momentum: float = 0.996
+    early_stopping_patience: int = 6
+    early_stopping_min_epochs: int = 8
+    seed: int = 42
+
+
+@dataclass(frozen=True)
+class _Sample:
+    sequence_id: str
+    state: EAPObjectState
+    previous: EAPObjectState
+    first: EAPObjectState
+
+
+class EAPGeoV2Dataset(Dataset[tuple[torch.Tensor, ...]]):
+    def __init__(self, root: str | Path, sequence_ids: list[str], config: EAPGeoV2Config) -> None:
+        self.root, self.config = Path(root), config
+        media = load_eap_media_table(self.root, split="train")
+        self.samples: list[_Sample] = []
+        for sequence_id in sorted(sequence_ids):
+            sequence_media = media[media["sequence_id"].astype(str) == sequence_id].copy()
+            labels = load_eap_sequence_labels(self.root, sequence_id, split="train")
+            states = reconstruct_eap_object_states(sequence_media, labels)
+            candidates: list[_Sample] = []
+            strata: list[tuple[str, ...]] = []
+            by_track: dict[str, list[EAPObjectState]] = {}
+            for state in states:
+                by_track.setdefault(state.track_id, []).append(state)
+            for track in by_track.values():
+                track.sort(key=lambda value: value.timestamp_us)
+                for index in range(1, len(track)):
+                    state, previous = track[index], track[index - 1]
+                    gap_s = (state.timestamp_us - previous.timestamp_us) * 1e-6
+                    if not 0.0 < gap_s <= 0.5:
+                        continue
+                    target = motion_risk_target(state, previous, track[0])
+                    candidates.append(_Sample(sequence_id, state, previous, track[0]))
+                    strata.append(target.stratum)
+            if candidates:
+                chosen = balanced_round_robin_indices(
+                    strata, min(len(candidates), config.max_samples_per_sequence), seed=config.seed
+                )
+                self.samples.extend(candidates[index] for index in chosen)
+        if not self.samples:
+            raise ValueError("No balanced eAP-Geo-v2 samples were found.")
+        self._readers: dict[str, EAPEventReader] = {}
+
+    def __len__(self) -> int:
+        return len(self.samples)
+
+    def _reader(self, sequence_id: str) -> EAPEventReader:
+        reader = self._readers.get(sequence_id)
+        if reader is None:
+            reader = EAPEventReader(self.root / "data" / "train" / sequence_id / "events.h5")
+            reader.open()
+            self._readers[sequence_id] = reader
+        return reader
+
+    def _full(self, sequence_id: str, end_us: int) -> torch.Tensor:
+        start_us = end_us - self.config.event_window_ms * 1000
+        events = self._reader(sequence_id).read_window(start_us, end_us)
+        return base_compatible_voxel(
+            downsample_full_frame(
+                events,
+                sequence_id=sequence_id,
+                start_us=start_us,
+                end_us=end_us,
+                width=self.config.full_width,
+                height=self.config.full_height,
+            ),
+            bins=self.config.bins,
+        )
+
+    def _roi(self, sample: _Sample, state: EAPObjectState) -> torch.Tensor:
+        end_us = state.timestamp_us
+        start_us = end_us - self.config.event_window_ms * 1000
+        events = self._reader(sample.sequence_id).read_window(start_us, end_us)
+        cropped = crop_events_to_roi(
+            events,
+            state.bbox_xyxy,
+            sequence_id=sample.sequence_id,
+            start_us=start_us,
+            end_us=end_us,
+            output_size=(self.config.roi_size, self.config.roi_size),
+        )
+        return base_compatible_voxel(cropped, bins=self.config.bins)
+
+    def __getitem__(self, index: int) -> tuple[torch.Tensor, ...]:
+        sample = self.samples[index]
+        target = motion_risk_target(sample.state, sample.previous, sample.first)
+        full = self._full(sample.sequence_id, sample.state.timestamp_us)
+        futures = torch.stack(
+            [self._full(sample.sequence_id, sample.state.timestamp_us + h * 1000) for h in self.config.horizons_ms]
+        )
+        roi_pair = torch.stack((self._roi(sample, sample.previous), self._roi(sample, sample.state)))
+        from e_jepa_ttc.data.eap_roi import bbox_foreground_proxy
+
+        foreground = torch.from_numpy(bbox_foreground_proxy(sample.state))
+        return (
+            full,
+            futures,
+            roi_pair,
+            torch.from_numpy(target.values),
+            torch.from_numpy(target.valid),
+            foreground,
+        )
+
+    def close(self) -> None:
+        for reader in self._readers.values():
+            reader.close()
+        self._readers.clear()
+
+    def __del__(self) -> None:
+        self.close()
+
+
+def _split_sequences(split_path: Path, role: str) -> list[str]:
+    payload = read_structured(split_path)
+    assignments = payload.get("assignments", {})
+    values = assignments.get(role)
+    if not isinstance(values, list) or not values:
+        raise ValueError(f"Split has no non-empty {role!r} assignment.")
+    return sorted(str(value) for value in values)
+
+
+def _epoch(
+    *,
+    model: EAPGeoV2Model,
+    target_encoder: nn.Module,
+    future_predictors: nn.ModuleList,
+    loader: DataLoader,
+    config: EAPGeoV2Config,
+    device: torch.device,
+    optimizer: torch.optim.Optimizer | None,
+) -> dict[str, float]:
+    train = optimizer is not None
+    model.train(train)
+    future_predictors.train(train)
+    target_encoder.eval()
+    totals: dict[str, float] = {}
+    count = 0
+    for full, futures, roi_pair, geometry, valid, foreground in loader:
+        full, futures, roi_pair = full.to(device), futures.to(device), roi_pair.to(device)
+        geometry, valid, foreground = geometry.to(device), valid.to(device), foreground.to(device)
+        output = model(full, roi_pair)
+        with torch.no_grad():
+            future_embeddings = torch.stack(
+                [target_encoder(futures[:, horizon]) for horizon in range(futures.shape[1])], dim=1
+            )
+        predicted = torch.stack(
+            [future_predictors[h](output.full_embedding) for h in range(futures.shape[1])], dim=1
+        )
+        jepa = F.smooth_l1_loss(F.normalize(predicted.float(), dim=-1), F.normalize(future_embeddings.float(), dim=-1), beta=0.1)
+        per_geometry = F.smooth_l1_loss(output.geometry, geometry, beta=0.1, reduction="none")
+        geometry_loss = (per_geometry * valid).sum() / valid.sum().clamp_min(1)
+        foreground_loss = F.binary_cross_entropy_with_logits(output.foreground_logits, foreground)
+        roi_alignment = 1.0 - F.cosine_similarity(
+            output.full_embedding.float(), output.roi_embedding[:, 1].float(), dim=-1
+        ).mean()
+        loss = (
+            config.jepa_weight * jepa
+            + config.geometry_weight * geometry_loss
+            + config.foreground_weight * foreground_loss
+            + config.roi_alignment_weight * roi_alignment
+        )
+        if train:
+            optimizer.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(
+                [*model.parameters(), *future_predictors.parameters()], 1.0
+            )
+            optimizer.step()
+            _update_ema(target_encoder, model.encoder, momentum=config.ema_momentum)
+        values = {
+            "loss": loss,
+            "loss_jepa": jepa,
+            "loss_geometry": geometry_loss,
+            "loss_foreground": foreground_loss,
+            "loss_roi_alignment": roi_alignment,
+        }
+        for name, value in values.items():
+            totals[name] = totals.get(name, 0.0) + float(value.detach().cpu())
+        count += 1
+    return {name: value / max(count, 1) for name, value in totals.items()}
+
+
+def train_eap_geo_v2(
+    *,
+    root: str | Path,
+    inventory_path: str | Path,
+    split_path: str | Path,
+    output_dir: str | Path,
+    config: EAPGeoV2Config,
+    device: str = "auto",
+) -> dict[str, Any]:
+    """Train and save a validation-selected Geo-v2 encoder checkpoint."""
+
+    _set_seed(config.seed)
+    resolved_device = torch.device("cuda" if device == "auto" and torch.cuda.is_available() else device if device != "auto" else "cpu")
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    split = Path(split_path)
+    train_data = EAPGeoV2Dataset(root, _split_sequences(split, "train"), config)
+    val_data = EAPGeoV2Dataset(root, _split_sequences(split, "validation"), config)
+    loader_args = dict(batch_size=config.batch_size, num_workers=config.workers, pin_memory=resolved_device.type == "cuda")
+    train_loader = DataLoader(train_data, shuffle=True, **loader_args)
+    val_loader = DataLoader(val_data, shuffle=False, **loader_args)
+    model = EAPGeoV2Model().to(resolved_device)
+    target_encoder = copy.deepcopy(model.encoder).to(resolved_device).eval().requires_grad_(False)
+    dim = int(model.encoder.output_dim)
+    predictors = nn.ModuleList(
+        [nn.Sequential(nn.LayerNorm(dim), nn.Linear(dim, dim), nn.GELU(), nn.Linear(dim, dim)) for _ in config.horizons_ms]
+    ).to(resolved_device)
+    optimizer = torch.optim.AdamW(
+        [*model.parameters(), *predictors.parameters()], lr=config.learning_rate, weight_decay=config.weight_decay
+    )
+    best, best_epoch, stale, history = float("inf"), 0, 0, []
+    started = time.perf_counter()
+    for epoch in range(1, config.epochs + 1):
+        train_metrics = _epoch(model=model, target_encoder=target_encoder, future_predictors=predictors, loader=train_loader, config=config, device=resolved_device, optimizer=optimizer)
+        with torch.no_grad():
+            val_metrics = _epoch(model=model, target_encoder=target_encoder, future_predictors=predictors, loader=val_loader, config=config, device=resolved_device, optimizer=None)
+        history.append({"epoch": epoch, "train": train_metrics, "validation": val_metrics})
+        checkpoint = {
+            "external_pretraining": True,
+            "pretraining_regime": "eap_geo_v2",
+            "pretraining_dataset_id": "EAP_PUBLIC_TRAIN40",
+            "model_name": "event-tubelet-transformer",
+            "in_channels": EVTTC_BASE_INPUT_CHANNELS,
+            "bins": config.bins,
+            "encoder_state_dict": model.encoder.state_dict(),
+            "roi_encoder_state_dict": model.roi_encoder.state_dict(),
+            "geo_v2_state_dict": model.state_dict(),
+            "target_encoder_state_dict": target_encoder.state_dict(),
+            "predictor_state_dict": predictors.state_dict(),
+            "epoch": epoch,
+            "checkpoint_role": "last",
+            "checkpoint_selected_by": "final_epoch",
+            "uses_ttc_labels": False,
+            "uses_collision_labels": False,
+            "uses_object_bboxes": True,
+            "uses_depth_track_derivatives": True,
+            "uses_labels_for_window_sampling": True,
+            "uses_balanced_track_sampling": True,
+            "uses_visibility_targets": True,
+            "uses_collision_corridor_targets": True,
+            "uses_object_categories": True,
+            "uses_object_roi": True,
+            "uses_rgb": False,
+            "uses_evttc_pretraining_events": False,
+            "benchmark10_opened": False,
+            "inventory_artifact_sha256": _artifact_hash(Path(inventory_path)),
+            "split_artifact_sha256": _artifact_hash(split),
+            "trainer_config": asdict(config),
+            "git_commit": _git_commit(),
+            "source_tree_sha256": _source_tree_hash(),
+        }
+        _atomic_torch_save(checkpoint, output / "eap_geo_v2_encoder_last.pt")
+        if val_metrics["loss"] < best:
+            best, best_epoch, stale = val_metrics["loss"], epoch, 0
+            checkpoint["checkpoint_role"] = "best"
+            checkpoint["checkpoint_selected_by"] = "validation_loss"
+            _atomic_torch_save(checkpoint, output / "eap_geo_v2_encoder_best.pt")
+        else:
+            stale += 1
+        if epoch >= config.early_stopping_min_epochs and stale >= config.early_stopping_patience:
+            break
+    result = {
+        "artifact_type": "eap_geo_v2_pretraining_v1",
+        "best_epoch": best_epoch,
+        "best_validation_loss": best,
+        "epochs_completed": len(history),
+        "elapsed_seconds": time.perf_counter() - started,
+        "selected_train_samples": len(train_data),
+        "selected_validation_samples": len(val_data),
+        "history": history,
+    }
+    write_structured(output / "summary.json", result)
+    train_data.close(); val_data.close()
+    return result
+
+
+__all__ = ["EAPGeoV2Config", "EAPGeoV2Dataset", "train_eap_geo_v2"]
diff --git a/src/e_jepa_ttc/training/eap_lhr_jepa_ttc.py b/src/e_jepa_ttc/training/eap_lhr_jepa_ttc.py
new file mode 100644
index 0000000..f0b68ed
--- /dev/null
+++ b/src/e_jepa_ttc/training/eap_lhr_jepa_ttc.py
@@ -0,0 +1,395 @@
+"""Train a deployable eAP LHR-JEPA-TTC model and preserve its complete head."""
+
+from __future__ import annotations
+
+import copy
+import math
+import time
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+from torch.utils.data import DataLoader, Dataset
+
+from e_jepa_ttc.data.eap import (
+    EAPEventReader,
+    EAPObjectState,
+    load_eap_media_table,
+    load_eap_sequence_labels,
+    reconstruct_eap_object_states,
+)
+from e_jepa_ttc.data.eap_motion_risk import balanced_round_robin_indices, motion_risk_target
+from e_jepa_ttc.data.garlttc_eap import load_garlttc_train_index
+from e_jepa_ttc.data.eap_roi import bbox_foreground_proxy, build_garl_eap_pair
+from e_jepa_ttc.models.eap_lhr_jepa_ttc import EAPLHRJEPATTC, EAPLHRJEPATTCOutput
+from e_jepa_ttc.training.carla_jepa import (
+    _artifact_hash,
+    _atomic_torch_save,
+    _git_commit,
+    _set_seed,
+    _source_tree_hash,
+)
+from e_jepa_ttc.training.jepa import _update_ema
+from e_jepa_ttc.utils.io import read_structured, write_structured
+
+
+@dataclass(frozen=True)
+class EAPLHRConfig:
+    epochs: int = 30
+    batch_size: int = 24
+    learning_rate: float = 3e-4
+    weight_decay: float = 1e-3
+    workers: int = 8
+    max_samples_per_sequence: int = 512
+    maximum_history_gap_ms: int = 150
+    height_weight: float = 0.5
+    ratio_weight: float = 1.0
+    ttc_weight: float = 0.25
+    jepa_weight: float = 0.1
+    jepa_ema_momentum: float = 0.996
+    foreground_weight: float = 0.1
+    early_stopping_patience: int = 6
+    early_stopping_min_epochs: int = 8
+    seed: int = 42
+
+
+@dataclass(frozen=True)
+class _LHRWindow:
+    sequence_id: str
+    history: tuple[EAPObjectState, EAPObjectState, EAPObjectState]
+    target_ttc_s: float
+
+
+def signed_log1p(value: torch.Tensor) -> torch.Tensor:
+    return torch.sign(value) * torch.log1p(value.abs())
+
+
+def _garl_lookup(
+    root: str | Path,
+    sequence_ids: list[str],
+) -> tuple[dict[tuple[str, str, str], float], dict[str, object]]:
+    """Load the repository-audited five-key GarlTTC/eAP join."""
+
+    index = load_garlttc_train_index(Path(root), sequence_ids)
+    lookup: dict[tuple[str, str, str], float] = {}
+    for row in index.merged.itertuples(index=False):
+        value = float(row.ttc)
+        if np.isfinite(value):
+            lookup[(str(row.sequence_id), str(row.sample_token), str(row.track_id))] = value
+    provenance = {
+        "garlttc_data_sha256": index.data_sha256,
+        "garlttc_annotations_sha256": index.annotations_sha256,
+        "garlttc_join_keys_sha256": index.join_keys_sha256,
+        "garlttc_full_joined_row_count": index.source_merged_row_count,
+        "garlttc_selected_row_count": index.selected_row_count,
+    }
+    return lookup, provenance
+
+
+
+class EAPLHRDataset(Dataset[tuple[torch.Tensor, ...]]):
+    def __init__(
+        self,
+        eap_root: str | Path,
+        garlttc_root: str | Path,
+        sequence_ids: list[str],
+        config: EAPLHRConfig,
+    ) -> None:
+        self.root, self.config = Path(eap_root), config
+        media = load_eap_media_table(self.root, split="train")
+        lookup, self.garlttc_provenance = _garl_lookup(garlttc_root, sequence_ids)
+        self.samples: list[_LHRWindow] = []
+        for sequence_id in sorted(sequence_ids):
+            sequence_media = media[media["sequence_id"].astype(str) == sequence_id].copy()
+            labels = load_eap_sequence_labels(self.root, sequence_id, split="train")
+            states = reconstruct_eap_object_states(sequence_media, labels)
+            candidates: list[_LHRWindow] = []
+            strata: list[tuple[str, ...]] = []
+            by_track: dict[str, list[EAPObjectState]] = {}
+            for state in states:
+                by_track.setdefault(state.track_id, []).append(state)
+            for track in by_track.values():
+                track.sort(key=lambda value: value.timestamp_us)
+                for index in range(2, len(track)):
+                    history = tuple(track[index - 2 : index + 1])
+                    gaps_ms = np.diff([state.timestamp_us for state in history]) * 1e-3
+                    if np.any(gaps_ms <= 0) or np.any(gaps_ms > config.maximum_history_gap_ms):
+                        continue
+                    target = history[-1]
+                    key = (target.sequence_id, target.sample_token, target.track_id)
+                    ttc = lookup.get(key)
+                    if ttc is None:
+                        continue
+                    feature = motion_risk_target(target, history[-2], track[0])
+                    candidates.append(_LHRWindow(sequence_id, history, float(ttc)))
+                    strata.append(feature.stratum)
+            if candidates:
+                selected = balanced_round_robin_indices(
+                    strata,
+                    min(len(candidates), config.max_samples_per_sequence),
+                    seed=config.seed,
+                )
+                self.samples.extend(candidates[index] for index in selected)
+        if not self.samples:
+            raise ValueError("No Garl-labelled eAP LHR windows were found.")
+        self._readers: dict[str, EAPEventReader] = {}
+
+    def __len__(self) -> int:
+        return len(self.samples)
+
+    def _reader(self, sequence_id: str) -> EAPEventReader:
+        reader = self._readers.get(sequence_id)
+        if reader is None:
+            reader = EAPEventReader(self.root / "data" / "train" / sequence_id / "events.h5")
+            reader.open()
+            self._readers[sequence_id] = reader
+        return reader
+
+    def __getitem__(self, index: int) -> tuple[torch.Tensor, ...]:
+        sample = self.samples[index]
+        event_roi, heights, elapsed_s = build_garl_eap_pair(
+            self._reader(sample.sequence_id), sample.history
+        )
+        foreground = bbox_foreground_proxy(sample.history[-1])
+        return (
+            torch.from_numpy(event_roi),
+            torch.tensor(elapsed_s, dtype=torch.float32),
+            torch.from_numpy(heights),
+            torch.tensor(sample.target_ttc_s, dtype=torch.float32),
+            torch.from_numpy(foreground),
+        )
+
+    def close(self) -> None:
+        for reader in self._readers.values():
+            reader.close()
+        self._readers.clear()
+
+    def __del__(self) -> None:
+        self.close()
+
+
+def lhr_loss(
+    output: EAPLHRJEPATTCOutput,
+    *,
+    target_heights: torch.Tensor,
+    target_ttc_s: torch.Tensor,
+    foreground: torch.Tensor,
+    config: EAPLHRConfig,
+    target_second_embedding: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:
+    target_ratio = target_heights[:, 0] / target_heights[:, 1].clamp_min(1e-6)
+    height = F.smooth_l1_loss(
+        output.visible_heights.log(), target_heights.clamp_min(1e-3).log(), beta=0.1
+    )
+    ratio = F.smooth_l1_loss(
+        output.height_ratio.clamp_min(1e-6).log(), target_ratio.clamp_min(1e-6).log(), beta=0.1
+    )
+    ttc = F.smooth_l1_loss(
+        signed_log1p(output.ttc_seconds.clamp(-100.0, 100.0)),
+        signed_log1p(target_ttc_s),
+        beta=0.1,
+    )
+    direct_ttc = F.smooth_l1_loss(
+        signed_log1p(output.direct_ttc_seconds.clamp(-100.0, 100.0)),
+        signed_log1p(target_ttc_s),
+        beta=0.1,
+    )
+    target_embedding = (
+        output.second_embedding.detach()
+        if target_second_embedding is None
+        else target_second_embedding.detach()
+    )
+    jepa = F.smooth_l1_loss(
+        F.normalize(output.predicted_second_embedding.float(), dim=-1),
+        F.normalize(target_embedding.float(), dim=-1),
+        beta=0.1,
+    )
+    fg = F.binary_cross_entropy_with_logits(output.foreground_logits, foreground)
+    total = (
+        config.ratio_weight * ratio
+        + config.height_weight * height
+        + config.ttc_weight * (0.75 * ttc + 0.25 * direct_ttc)
+        + config.jepa_weight * jepa
+        + config.foreground_weight * fg
+    )
+    return total, {
+        "height": height,
+        "ratio": ratio,
+        "ttc": ttc,
+        "direct_ttc": direct_ttc,
+        "jepa": jepa,
+        "foreground": fg,
+    }
+
+
+def _sequence_ids(split_path: Path, role: str) -> list[str]:
+    values = read_structured(split_path).get("assignments", {}).get(role)
+    if not isinstance(values, list) or not values:
+        raise ValueError(f"Split has no {role!r} sequences.")
+    return sorted(str(value) for value in values)
+
+
+def _run_epoch(
+    model: EAPLHRJEPATTC,
+    loader: DataLoader,
+    config: EAPLHRConfig,
+    device: torch.device,
+    optimizer: torch.optim.Optimizer | None,
+    target_tower: torch.nn.Module | None = None,
+) -> dict[str, float]:
+    train = optimizer is not None
+    model.train(train)
+    totals: dict[str, float] = {}
+    errors: list[float] = []
+    relative: list[float] = []
+    batches = 0
+    for event_roi, elapsed, heights, ttc, foreground in loader:
+        event_roi, elapsed = event_roi.to(device), elapsed.to(device)
+        heights, ttc, foreground = heights.to(device), ttc.to(device), foreground.to(device)
+        output = model(event_roi, elapsed)
+        target_second_embedding = None
+        if target_tower is not None:
+            with torch.no_grad():
+                second_interval = event_roi[:, model.roi_planes :]
+                target_second_embedding = target_tower(second_interval)
+        loss, pieces = lhr_loss(
+            output,
+            target_heights=heights,
+            target_ttc_s=ttc,
+            foreground=foreground,
+            config=config,
+            target_second_embedding=target_second_embedding,
+        )
+        if train:
+            optimizer.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
+            optimizer.step()
+            if target_tower is not None:
+                _update_ema(target_tower[0], model.roi_adapter, momentum=config.jepa_ema_momentum)
+                _update_ema(target_tower[1], model.encoder, momentum=config.jepa_ema_momentum)
+        prediction = output.ttc_seconds.detach().clamp(-100.0, 100.0)
+        absolute = (prediction - ttc).abs()
+        errors.extend(absolute.cpu().tolist())
+        relative.extend((absolute / ttc.abs().clamp_min(0.25)).cpu().tolist())
+        totals["loss"] = totals.get("loss", 0.0) + float(loss.detach().cpu())
+        for name, value in pieces.items():
+            totals[f"loss_{name}"] = totals.get(f"loss_{name}", 0.0) + float(value.detach().cpu())
+        batches += 1
+    metrics = {name: value / max(batches, 1) for name, value in totals.items()}
+    metrics["mae_s"] = float(np.mean(errors)) if errors else float("nan")
+    metrics["mean_relative_error"] = float(np.mean(relative)) if relative else float("nan")
+    metrics["selection_score"] = metrics["mean_relative_error"] + 0.25 * metrics["mae_s"]
+    return metrics
+
+
+def train_eap_lhr_jepa_ttc(
+    *,
+    eap_root: str | Path,
+    garlttc_root: str | Path,
+    inventory_path: str | Path,
+    split_path: str | Path,
+    output_dir: str | Path,
+    config: EAPLHRConfig,
+    geo_checkpoint: str | Path | None = None,
+    device: str = "auto",
+) -> dict[str, Any]:
+    _set_seed(config.seed)
+    resolved = torch.device("cuda" if device == "auto" and torch.cuda.is_available() else device if device != "auto" else "cpu")
+    output = Path(output_dir); output.mkdir(parents=True, exist_ok=True)
+    split = Path(split_path)
+    train_data = EAPLHRDataset(eap_root, garlttc_root, _sequence_ids(split, "train"), config)
+    val_data = EAPLHRDataset(eap_root, garlttc_root, _sequence_ids(split, "validation"), config)
+    args = dict(batch_size=config.batch_size, num_workers=config.workers, pin_memory=resolved.type == "cuda")
+    train_loader = DataLoader(train_data, shuffle=True, **args)
+    val_loader = DataLoader(val_data, shuffle=False, **args)
+    model = EAPLHRJEPATTC().to(resolved)
+    geo_init: dict[str, Any] | None = None
+    if geo_checkpoint is not None:
+        checkpoint = torch.load(geo_checkpoint, map_location="cpu", weights_only=False)
+        missing, unexpected = model.initialize_encoder_from_geo(checkpoint)
+        geo_init = {"path": Path(geo_checkpoint).as_posix(), "missing": missing, "unexpected": unexpected}
+    target_tower = torch.nn.Sequential(
+        copy.deepcopy(model.roi_adapter),
+        copy.deepcopy(model.encoder),
+    ).to(resolved).eval().requires_grad_(False)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=config.learning_rate, weight_decay=config.weight_decay)
+    best, best_epoch, stale, history = float("inf"), 0, 0, []
+    started = time.perf_counter()
+    for epoch in range(1, config.epochs + 1):
+        train_metrics = _run_epoch(
+            model, train_loader, config, resolved, optimizer, target_tower=target_tower
+        )
+        with torch.no_grad():
+            validation = _run_epoch(
+                model, val_loader, config, resolved, None, target_tower=target_tower
+            )
+        history.append({"epoch": epoch, "train": train_metrics, "validation": validation})
+        checkpoint = {
+            "artifact_type": "eap_lhr_jepa_ttc_checkpoint_v1",
+            "external_pretraining": True,
+            "pretraining_regime": "eap_lhr_jepa_ttc",
+            "pretraining_dataset_id": "EAP_PUBLIC_TRAIN40_PLUS_GARLTTC_TRAIN_LABELS",
+            "model_name": "eap-lhr-jepa-ttc-event-tubelet",
+            "model_state_dict": model.state_dict(),
+            "encoder_state_dict": model.encoder.state_dict(),
+            "height_ratio_head_state_dict": model.height_ratio_head.state_dict(),
+            "target_tower_state_dict": target_tower.state_dict(),
+            "checkpoint_role": "last",
+            "checkpoint_selected_by": "final_epoch",
+            "epoch": epoch,
+            "seed": config.seed,
+            "full_model_transferable_to_evttc": True,
+            "transferred_components": ["roi_adapter", "encoder", "pair_fusion", "height_ratio_head", "direct_ttc_head"],
+            "discarded_pretraining_heads": ["jepa_predictor", "foreground_head"],
+            "uses_ttc_labels": True,
+            "uses_object_bboxes": True,
+            "uses_object_roi": True,
+            "uses_labels_for_window_sampling": True,
+            "uses_ttc_value_for_sampling": False,
+            "uses_rgb": False,
+            "uses_evttc_pretraining_events": False,
+            "benchmark10_opened": False,
+            **train_data.garlttc_provenance,
+            "inventory_artifact_sha256": _artifact_hash(Path(inventory_path)),
+            "split_artifact_sha256": _artifact_hash(split),
+            "trainer_config": asdict(config),
+            "geo_initialization": geo_init,
+            "git_commit": _git_commit(),
+            "source_tree_sha256": _source_tree_hash(),
+        }
+        _atomic_torch_save(checkpoint, output / "eap_lhr_jepa_ttc_last.pt")
+        if validation["selection_score"] < best:
+            best, best_epoch, stale = validation["selection_score"], epoch, 0
+            checkpoint["checkpoint_role"] = "best"
+            checkpoint["checkpoint_selected_by"] = "validation_selection_score"
+            _atomic_torch_save(checkpoint, output / "eap_lhr_jepa_ttc_best.pt")
+        else:
+            stale += 1
+        if epoch >= config.early_stopping_min_epochs and stale >= config.early_stopping_patience:
+            break
+    result = {
+        "artifact_type": "eap_lhr_jepa_ttc_training_v1",
+        "best_epoch": best_epoch,
+        "best_validation_selection_score": best,
+        "epochs_completed": len(history),
+        "elapsed_seconds": time.perf_counter() - started,
+        "train_samples": len(train_data),
+        "validation_samples": len(val_data),
+        "history": history,
+    }
+    write_structured(output / "summary.json", result)
+    train_data.close(); val_data.close()
+    return result
+
+
+__all__ = [
+    "EAPLHRConfig",
+    "EAPLHRDataset",
+    "lhr_loss",
+    "signed_log1p",
+    "train_eap_lhr_jepa_ttc",
+]
