+#!/usr/bin/env python
+"""Zero-shot evaluation of the preserved eAP LHR model on an EvTTC object cache."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+from e_jepa_ttc.data.eap_cache import EAPObjectCacheDataset
+from e_jepa_ttc.models.eap_lhr_jepa_ttc import EAPLHRJEPATTC
+from e_jepa_ttc.utils.io import write_structured
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--cache-manifest", required=True)
+    parser.add_argument("--splits", nargs="+", default=["validation"])
+    parser.add_argument("--batch-size", type=int, default=24)
+    parser.add_argument("--workers", type=int, default=4)
+    parser.add_argument("--device", default="auto")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    device = torch.device("cuda" if args.device == "auto" and torch.cuda.is_available() else args.device if args.device != "auto" else "cpu")
+    checkpoint = torch.load(args.checkpoint, map_location="cpu", weights_only=False)
+    if checkpoint.get("full_model_transferable_to_evttc") is not True:
+        raise ValueError("Checkpoint does not declare full-head EvTTC transferability.")
+    model = EAPLHRJEPATTC().to(device)
+    model.load_state_dict(checkpoint["model_state_dict"])
+    model.eval()
+    dataset = EAPObjectCacheDataset(args.cache_manifest, splits=tuple(args.splits))
+    loader = DataLoader(dataset, batch_size=args.batch_size, num_workers=args.workers)
+    errors: list[float] = []
+    relative: list[float] = []
+    rows: list[dict[str, object]] = []
+    with torch.no_grad():
+        for batch in loader:
+            event_roi = batch["garl_event_roi"].to(device=device, dtype=torch.float32)
+            elapsed = batch["garl_delta_t_s"].to(device=device, dtype=torch.float32).reshape(-1)
+            target = batch["ttc_s"].to(device=device, dtype=torch.float32).reshape(-1)
+            prediction = model(event_roi, elapsed).ttc_seconds.clamp(-100.0, 100.0)
+            absolute = (prediction - target).abs()
+            errors.extend(absolute.cpu().tolist())
+            relative.extend((absolute / target.abs().clamp_min(0.25)).cpu().tolist())
+            for idx in range(target.shape[0]):
+                rows.append(
+                    {
+                        "sample_token": batch["sample_token"][idx],
+                        "sequence_id": batch["sequence_id"][idx],
+                        "track_id": (
+                            batch["track_id"][idx]
+                            if "track_id" in batch
+                            else ""
+                        ),
+                        "target_ttc_s": float(target[idx].cpu()),
+                        "predicted_ttc_s": float(prediction[idx].cpu()),
+                        "absolute_error_s": float(absolute[idx].cpu()),
+                    }
+                )
+    payload = {
+        "artifact_type": "eap_lhr_zero_shot_evttc_v1",
+        "checkpoint": Path(args.checkpoint).as_posix(),
+        "cache_manifest": Path(args.cache_manifest).as_posix(),
+        "sample_count": len(errors),
+        "mae_s": float(np.mean(errors)),
+        "mean_relative_error": float(np.mean(relative)),
+        "selection_score": float(np.mean(relative) + 0.25 * np.mean(errors)),
+        "benchmark10_opened": False,
+        "predictions": rows,
+    }
+    write_structured(args.output, payload)
+    print(json.dumps({key: value for key, value in payload.items() if key != "predictions"}, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
