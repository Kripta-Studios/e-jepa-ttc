@@ -0,0 +1,110 @@
+"""Object-centric eAP event representations shared by Geo-v2 and LHR-TTC."""
+
+from __future__ import annotations
+
+import numpy as np
+import torch
+from torch.nn import functional
+
+from e_jepa_ttc.data.eap import EAPEventReader, EAPObjectState
+
+
+def _common_square(states: tuple[EAPObjectState, EAPObjectState]) -> int:
+    boxes = np.asarray([state.bbox_xyxy for state in states], dtype=np.float64)
+    return max(1, int(np.ceil(np.maximum(boxes[:, 2] - boxes[:, 0], boxes[:, 3] - boxes[:, 1]).max())))
+
+
+def garl_time_surface_volume(
+    events: dict[str, np.ndarray],
+    square_xyxy: tuple[int, int, int, int],
+    *,
+    planes: int = 20,
+    target_size: int = 128,
+) -> np.ndarray:
+    """Mirror the repository's EvTTC Garl time-volume transform for eAP."""
+
+    x0, y0, x1, y1 = square_xyxy
+    width, height = max(1, x1 - x0), max(1, y1 - y0)
+    volume = np.zeros((planes, height, width), dtype=np.float32)
+    t = np.asarray(events["t"], dtype=np.int64)
+    if t.size:
+        x = np.asarray(events["x"], dtype=np.int64)
+        y = np.asarray(events["y"], dtype=np.int64)
+        relative_s = (t - t[0]).astype(np.float64) * 1e-6
+        duration_s = 0.1
+        bin_duration = duration_s / planes
+        selected = (
+            (x >= x0) & (x < x1) & (y >= y0) & (y < y1) & (relative_s < duration_s - 1e-5)
+        )
+        x, y = x[selected] - x0, y[selected] - y0
+        times = relative_s[selected].astype(np.float32)
+        if times.size:
+            time_index = np.clip((times / bin_duration).astype(np.int64), 0, planes - 1)
+            plane_size = height * width
+            flat_index = time_index * plane_size + y * width + x
+            order = np.argsort(flat_index, kind="stable")
+            sorted_flat = flat_index[order]
+            starts = np.r_[0, np.flatnonzero(sorted_flat[1:] != sorted_flat[:-1]) + 1]
+            counts = np.diff(np.r_[starts, len(sorted_flat)])
+            last_position = starts + counts - 1
+            last_event = order[last_position]
+            previous_event = order[np.maximum(last_position - 1, starts)]
+            plane_start = (sorted_flat[last_position] // plane_size) * bin_duration
+            previous_time = np.where(counts > 1, times[previous_event], plane_start)
+            values = np.exp(-((times[last_event] - previous_time) / bin_duration)).astype(np.float32)
+            volume.reshape(-1)[sorted_flat[last_position]] = values
+    tensor = torch.from_numpy(volume)[None]
+    return functional.interpolate(
+        tensor, size=(target_size, target_size), mode="bilinear", align_corners=True
+    )[0].numpy().astype(np.float32)
+
+
+def build_garl_eap_pair(
+    reader: EAPEventReader,
+    history: tuple[EAPObjectState, EAPObjectState, EAPObjectState],
+    *,
+    planes: int = 20,
+    target_size: int = 128,
+) -> tuple[np.ndarray, np.ndarray, float]:
+    """Return 40-plane ROI, resized visible-height targets and elapsed time."""
+
+    if len(history) != 3:
+        raise ValueError("Garl-compatible eAP preprocessing requires three states.")
+    endpoints = history[1:]
+    common_edge = _common_square(endpoints)
+    volumes: list[np.ndarray] = []
+    heights: list[float] = []
+    for interval_index, endpoint_index in ((0, 1), (1, 2)):
+        state = history[endpoint_index]
+        box = history[interval_index].bbox_xyxy
+        center_x = 0.5 * (box[0] + box[2])
+        center_y = 0.5 * (box[1] + box[3])
+        square = (
+            int(np.ceil(center_x - 0.5 * common_edge)),
+            int(np.ceil(center_y - 0.5 * common_edge)),
+            int(np.ceil(center_x + 0.5 * common_edge)),
+            int(np.ceil(center_y + 0.5 * common_edge)),
+        )
+        events = reader.read_window(history[interval_index].timestamp_us, state.timestamp_us)
+        volumes.append(garl_time_surface_volume(events, square, planes=planes, target_size=target_size))
+        heights.append((state.bbox_xyxy[3] - state.bbox_xyxy[1]) * target_size / common_edge)
+    elapsed_s = (history[2].timestamp_us - history[1].timestamp_us) * 1e-6
+    return np.concatenate(volumes).astype(np.float32), np.asarray(heights, np.float32), float(elapsed_s)
+
+
+def bbox_foreground_proxy(state: EAPObjectState, *, target_size: int = 32) -> np.ndarray:
+    """Rasterize a bbox-only foreground target; no segmentation is claimed."""
+
+    mask = np.zeros((target_size, target_size), dtype=np.float32)
+    # The object crop is square and centered on the bbox, so the bbox occupies
+    # the central region while preserving its aspect ratio.
+    w = max(1.0, state.bbox_xyxy[2] - state.bbox_xyxy[0])
+    h = max(1.0, state.bbox_xyxy[3] - state.bbox_xyxy[1])
+    scale = target_size / max(w, h)
+    rw, rh = max(1, int(round(w * scale))), max(1, int(round(h * scale)))
+    x0, y0 = (target_size - rw) // 2, (target_size - rh) // 2
+    mask[y0 : y0 + rh, x0 : x0 + rw] = 1.0
+    return mask
+
+
+__all__ = ["bbox_foreground_proxy", "build_garl_eap_pair", "garl_time_surface_volume"]
