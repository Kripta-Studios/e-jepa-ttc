+from __future__ import annotations
+
+import numpy as np
+
+from e_jepa_ttc.data.eap_roi import garl_time_surface_volume
+
+
+def test_garl_time_surface_shape_and_range():
+    events = {
+        "x": np.asarray([5, 5, 7], dtype=np.int32),
+        "y": np.asarray([5, 5, 8], dtype=np.int32),
+        "t": np.asarray([0, 10_000, 20_000], dtype=np.int64),
+        "p": np.asarray([1, -1, 1], dtype=np.int8),
+    }
+    volume = garl_time_surface_volume(events, (0, 0, 16, 16), planes=20, target_size=32)
+    assert volume.shape == (20, 32, 32)
+    assert np.isfinite(volume).all()
+    assert 0.0 <= float(volume.min()) <= float(volume.max()) <= 1.0
+    assert float(volume.sum()) > 0.0
