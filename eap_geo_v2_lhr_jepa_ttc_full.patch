+++ b/src/e_jepa_ttc/models/eap_lhr_jepa_ttc.py
@@ -0,0 +1,105 @@
+"""Deployable event-only LHR-JEPA-TTC model with a preserved geometric head."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping
+
+import torch
+from torch import nn
+
+from e_jepa_ttc.models import build_encoder
+from e_jepa_ttc.models.height_ratio_head import LearnedHeightRatioHead
+
+
+@dataclass(frozen=True)
+class EAPLHRJEPATTCOutput:
+    inverse_ttc: torch.Tensor
+    ttc_seconds: torch.Tensor
+    height_ratio: torch.Tensor
+    visible_heights: torch.Tensor
+    direct_ttc_seconds: torch.Tensor
+    first_embedding: torch.Tensor
+    second_embedding: torch.Tensor
+    predicted_second_embedding: torch.Tensor
+    foreground_logits: torch.Tensor
+
+
+class EAPLHRJEPATTC(nn.Module):
+    """Use the same 40-plane ROI input and full head for eAP and EvTTC."""
+
+    def __init__(self, *, roi_planes: int = 20, foreground_size: int = 32) -> None:
+        super().__init__()
+        self.roi_planes = roi_planes
+        # A learned channel adapter permits exact reuse of the 21-channel Geo
+        # transformer while accepting each 20-plane Garl interval.
+        self.roi_adapter = nn.Conv2d(roi_planes, 21, kernel_size=1, bias=False)
+        self.encoder = build_encoder("event-tubelet-transformer", in_channels=21)
+        dim = int(self.encoder.output_dim)
+        self.pair_fusion = nn.Sequential(
+            nn.LayerNorm(dim * 4),
+            nn.Linear(dim * 4, dim),
+            nn.GELU(),
+            nn.Dropout(0.1),
+        )
+        self.height_ratio_head = LearnedHeightRatioHead(dim)
+        self.direct_ttc_head = nn.Sequential(
+            nn.LayerNorm(dim), nn.Linear(dim, dim // 2), nn.GELU(), nn.Linear(dim // 2, 1)
+        )
+        self.jepa_predictor = nn.Sequential(
+            nn.LayerNorm(dim), nn.Linear(dim, dim), nn.GELU(), nn.Linear(dim, dim)
+        )
+        self.foreground_size = foreground_size
+        self.foreground_head = nn.Linear(dim, foreground_size * foreground_size)
+
+    def _encode(self, volume: torch.Tensor) -> torch.Tensor:
+        return self.encoder(self.roi_adapter(volume))
+
+    def forward(self, event_roi: torch.Tensor, elapsed_s: torch.Tensor) -> EAPLHRJEPATTCOutput:
+        if event_roi.ndim != 4 or event_roi.shape[1] != self.roi_planes * 2:
+            raise ValueError(
+                f"event_roi must have shape [B,{self.roi_planes * 2},H,W]."
+            )
+        first, second = event_roi.split(self.roi_planes, dim=1)
+        z1, z2 = self._encode(first), self._encode(second)
+        fused = self.pair_fusion(torch.cat((z1, z2, z2 - z1, z1 * z2), dim=-1))
+        raw_heights = self.height_ratio_head.height_regressor(fused)
+        heights = torch.nn.functional.softplus(raw_heights) + 1e-3
+        ratio = heights[:, 0] / heights[:, 1].clamp_min(1e-6)
+        inverse_ttc = (1.0 - ratio) / elapsed_s.clamp_min(1e-6)
+        safe_inverse = torch.where(
+            inverse_ttc.abs() >= 1e-5,
+            inverse_ttc,
+            torch.where(
+                inverse_ttc < 0,
+                torch.full_like(inverse_ttc, -1e-5),
+                torch.full_like(inverse_ttc, 1e-5),
+            ),
+        )
+        ttc = safe_inverse.reciprocal()
+        direct_raw = self.direct_ttc_head(fused).squeeze(-1)
+        direct = torch.sign(direct_raw) * torch.expm1(direct_raw.abs())
+        foreground = self.foreground_head(z2).reshape(
+            z2.shape[0], self.foreground_size, self.foreground_size
+        )
+        return EAPLHRJEPATTCOutput(
+            inverse_ttc=inverse_ttc,
+            ttc_seconds=ttc,
+            height_ratio=ratio,
+            visible_heights=heights,
+            direct_ttc_seconds=direct,
+            first_embedding=z1,
+            second_embedding=z2,
+            predicted_second_embedding=self.jepa_predictor(z1),
+            foreground_logits=foreground,
+        )
+
+    def initialize_encoder_from_geo(self, checkpoint: Mapping[str, object]) -> tuple[list[str], list[str]]:
+        state = checkpoint.get("encoder_state_dict")
+        if not isinstance(state, Mapping):
+            raise ValueError("Geo checkpoint has no encoder_state_dict.")
+        result = self.encoder.load_state_dict(state, strict=False)
+        return list(result.missing_keys), list(result.unexpected_keys)
+
+
+__all__ = ["EAPLHRJEPATTC", "EAPLHRJEPATTCOutput"]
