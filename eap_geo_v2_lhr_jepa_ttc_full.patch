@@ -0,0 +1,68 @@
+"""Dual-path full-frame + ROI encoder for eAP-Geo v2."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+from torch import nn
+
+from e_jepa_ttc.data.eap_motion_risk import GEO_V2_TARGET_DIM
+from e_jepa_ttc.models import build_encoder
+
+
+@dataclass(frozen=True)
+class EAPGeoV2Output:
+    full_embedding: torch.Tensor
+    roi_embedding: torch.Tensor
+    fused_embedding: torch.Tensor
+    geometry: torch.Tensor
+    foreground_logits: torch.Tensor
+
+
+class EAPGeoV2Model(nn.Module):
+    """Preserve an EvTTC-compatible full encoder while adding an ROI teacher path."""
+
+    def __init__(self, *, in_channels: int = 21, foreground_size: int = 32) -> None:
+        super().__init__()
+        self.encoder = build_encoder("event-tubelet-transformer", in_channels=in_channels)
+        self.roi_encoder = build_encoder("event-tubelet-transformer", in_channels=in_channels)
+        dim = int(self.encoder.output_dim)
+        self.fusion = nn.Sequential(
+            nn.LayerNorm(dim * 3),
+            nn.Linear(dim * 3, dim),
+            nn.GELU(),
+            nn.Dropout(0.1),
+        )
+        self.geometry_head = nn.Sequential(
+            nn.LayerNorm(dim),
+            nn.Linear(dim, dim // 2),
+            nn.GELU(),
+            nn.Linear(dim // 2, GEO_V2_TARGET_DIM),
+        )
+        self.foreground_size = foreground_size
+        self.foreground_head = nn.Sequential(
+            nn.LayerNorm(dim),
+            nn.Linear(dim, foreground_size * foreground_size),
+        )
+
+    def forward(self, full_frame: torch.Tensor, roi_pair: torch.Tensor) -> EAPGeoV2Output:
+        if roi_pair.ndim != 5 or roi_pair.shape[1] != 2:
+            raise ValueError("roi_pair must have shape [B,2,C,H,W].")
+        full = self.encoder(full_frame)
+        batch = roi_pair.shape[0]
+        roi = self.roi_encoder(roi_pair.flatten(0, 1)).reshape(batch, 2, -1)
+        fused = self.fusion(torch.cat((full, roi[:, 0], roi[:, 1] - roi[:, 0]), dim=-1))
+        foreground = self.foreground_head(roi[:, 1]).reshape(
+            batch, self.foreground_size, self.foreground_size
+        )
+        return EAPGeoV2Output(
+            full_embedding=full,
+            roi_embedding=roi,
+            fused_embedding=fused,
+            geometry=self.geometry_head(fused),
+            foreground_logits=foreground,
+        )
+
+
+__all__ = ["EAPGeoV2Model", "EAPGeoV2Output"]
