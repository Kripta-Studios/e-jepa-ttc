+    )
+    if ($IncludeRgb) {
+        $CacheBaseArgs += "--include-rgb"
+    }
+    if ($AllowDatasetVersionChange) {
+        $CacheBaseArgs += "--allow-dataset-version-change"
+    }
+
+    Invoke-NativeLogged "build_smoke_cache" $Python (
