  "phase_output_contract": {
    "phase_coordinate": "phi(T) = -log1p(-d/T)",
    "anchor_seconds": 0.1,
    "forward_input_domain": "Finite T < 0 or T > 0.1 seconds",
    "registered_minimum_phase_expression": "-log(2) + 1e-6",
    "registered_minimum_phase": -0.6931461805599453,
    "registered_maximum_phase": 8.0,
    "inverse_map": [
      "phi_c = clamp(raw_location, -log(2)+1e-6, 8)",
      "q = -expm1(-phi_c) / 0.1",
      "s = -1 if q < 0 else +1",
      "T_emitted = s / max(abs(q), 1/60)"
    ],
    "inverse_ttc_magnitude_floor_per_second": 0.016666666666666666,
    "maximum_emitted_ttc_magnitude_seconds": 60.0,
    "zero_phase_emits_ttc_seconds": 60.0,
    "nonfinite_input_policy": "Reject nonfinite phase before clamping",
    "point_phase": "emitted_phase(raw_location) = ttc_to_phase(phase_to_ttc(raw_location))",
    "point_phase_note": "The reported point phase is recomputed after finite-TTC saturation; it is not merely the clipped raw location.",
    "final_fusion_location": "raw_location = RGB_raw_location + 0.03 * correction[0]",
    "final_fusion_widths": "widths = 0.03 * softplus(RGB_width_logits + correction[1:3])",
    "phase_interval_outputs": {
      "q10": "clamp(raw_location - widths[0], MIN_PHASE, MAX_PHASE)",
      "q90": "clamp(raw_location + widths[1], MIN_PHASE, MAX_PHASE)"
    },
    "interpretation": "The registered phase limits are numerical constants. Learned widths form separately clamped phase-interval endpoints; neither those endpoints nor finite TTC saturation establishes calibrated collision probabilities or measured 60-second collision times.",
